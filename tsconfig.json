{
  "extends": "astro/tsconfigs/strict",
  "include": ["src"],
  "compilerOptions": {
    "declaration": true,
    "noEmit": true,
    // Enable top-level await, and other modern ESM features.
    "target": "ESNext",
    "module": "ESNext",
    // `moduleResolution` is inherited as "bundler" from `astro/tsconfigs/strict`,
    // which is required for subpath `exports` (e.g. `astro/zod`) to resolve.
    // Enable JSON imports.
    "resolveJsonModule": true,
    // Enable stricter transpilation for better output.
    "isolatedModules": true,
    "types": ["astro/client"],
    "strictNullChecks": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "outDir": "./dist"
  }
}
